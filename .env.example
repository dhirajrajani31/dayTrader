TRADING_MODE=SHADOW
TIMEZONE=America/Chicago
DATABASE_URL=sqlite:///data/tradingpilot.db
WATCHLIST_FILE=watchlist.txt
WATCHLIST_CONTEXT_FILE=watchlist_context.json
LOG_FILE=logs/tradingpilot.log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# production or sandbox; their OAuth credentials are not interchangeable.
TASTYTRADE_ENVIRONMENT=production
# Preferred: long-lived personal OAuth grant. Never commit these values.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
# Optional 15-minute fallback for diagnostics when refresh credentials are unavailable.
TASTYTRADE_ACCESS_TOKEN=
HISTORICAL_LOOKBACK_DAYS=5
HISTORICAL_WARMUP_TIMEOUT_SECONDS=20
# Deterministic one-contract option shadow execution policy.
OPTION_EXECUTION_POLICY_VERSION=OPTION_SHADOW_V1
OPTION_MIN_DAYS_TO_EXPIRATION=1
OPTION_MAX_DAYS_TO_EXPIRATION=7
OPTION_MINIMUM_ABS_DELTA=0.55
OPTION_MAXIMUM_ABS_DELTA=0.70
OPTION_TARGET_ABS_DELTA=0.625
OPTION_MAXIMUM_SPREAD_PCT=0.20
OPTION_QUANTITY=1
OPTION_MAXIMUM_HOLDING_MINUTES=60
# Current stock/ETF option commission plus conservative configurable fee/slippage estimates.
OPTION_OPENING_COMMISSION_PER_CONTRACT=1.00
OPTION_ESTIMATED_OPENING_FEES_PER_CONTRACT=0.15
OPTION_ESTIMATED_CLOSING_FEES_PER_CONTRACT=0.15
OPTION_ADDITIONAL_SLIPPAGE_PRICE_PER_SIDE=0.01
OPTION_EXECUTION_DELAY_TOLERANCE_SECONDS=15
OPTION_MAXIMUM_OPTION_QUOTE_AGE_SECONDS=30
